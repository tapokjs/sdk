{
  "name": "@tapokjs/sdk",
  "version": "1.0.0",
  "description": "Browser and server SDK for Tapok authentication",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapokjs/sdk.git"
  },
  "homepage": "https://tapok.orria.space/docs/sdk",
  "bugs": "https://github.com/tapokjs/sdk/issues",
  "keywords": [
    "tapok",
    "authentication",
    "oauth",
    "oidc",
    "pkce"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown src/index.ts src/browser.ts src/server.ts --format esm --platform neutral --target es2023 --dts --clean",
    "typecheck": "bun check --no-script --project tsconfig.json && bun check --no-script --project tsconfig.test.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@tapokjs/core": "^1.0.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "better-auth": "^1.7.18",
    "convex": "^1.45.0",
    "oauth4webapi": "^3.8.8",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.4-canary.20261109.1"
}
